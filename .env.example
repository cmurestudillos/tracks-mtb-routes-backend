# =============================================================
# TRACKS MTB ROUTES — Variables de entorno
# Copia este archivo como .env y rellena tus valores
# cp .env.example .env
# =============================================================

# -------------------------------------------------------------
# MongoDB
# -------------------------------------------------------------
# URI local para desarrollo
MONGO_URI=mongodb://127.0.0.1:27017/tracks-mtb-routes

# URI de MongoDB Atlas para producción (solo se usa en NODE_ENV=production)
MONGO_URI_PRODUCTION=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/tracks-mtb-routes?retryWrites=true&w=majority

# -------------------------------------------------------------
# Servidor
# -------------------------------------------------------------
PORT=5005
NODE_ENV=development

# -------------------------------------------------------------
# CORS — orígenes permitidos separados por comas
# En producción añade la URL del frontend desplegado
# -------------------------------------------------------------
# Desarrollo: solo localhost
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ORIGIN=http://localhost:5173

# URL del frontend en producción (Vercel, Netlify, etc.)
# Se suma automáticamente a ALLOWED_ORIGINS
FRONTEND_URL=https://tu-frontend.vercel.app

# -------------------------------------------------------------
# JWT
# Genera un secreto seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -------------------------------------------------------------
TOKEN_SECRET=reemplaza_esto_con_un_secreto_de_minimo_32_caracteres_aleatorio

# -------------------------------------------------------------
# Vercel Blob Storage
# Obtener en: Vercel Dashboard → tu proyecto → Storage → Blob
# -------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -------------------------------------------------------------
# Rate Limiting (opcional — estos son los valores por defecto)
# -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
